{
  "name": "@s8fy/xdoc",
  "version": "0.9.0",
  "description": "Agent-native PPTX runtime for editable PowerPoint creation and editing, high-fidelity PDF/PNG export, Markdown extraction, and CLI/MCP automation.",
  "keywords": [
    "ai-agent",
    "cli",
    "document",
    "document-automation",
    "document-converter",
    "html-to-markdown",
    "json-rpc",
    "markdown",
    "mcp",
    "pdf",
    "png",
    "powerpoint",
    "pptx",
    "pptx-editor",
    "pptx-generator",
    "pptx-to-pdf",
    "presentation",
    "slides",
    "xdoc"
  ],
  "homepage": "https://github.com/hustcer/workers/tree/main/xdoc-npm#readme",
  "bugs": {
    "url": "https://github.com/hustcer/workers/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "hustcer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hustcer/workers.git",
    "directory": "xdoc-npm"
  },
  "bin": {
    "xdoc": "lib/index.cjs"
  },
  "files": [
    "lib",
    "platforms.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "preinstall": "node lib/check-platform.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "optionalDependencies": {
    "@s8fy/xdoc-linux-arm64": "0.9.0",
    "@s8fy/xdoc-linux-x64": "0.9.0",
    "@s8fy/xdoc-macos-arm64": "0.9.0",
    "@s8fy/xdoc-windows-x64": "0.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "preferUnplugged": true,
  "xdoc": {
    "releaseTag": "v0.9.0",
    "sourceRepository": "hustcer/pptx"
  }
}
